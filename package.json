{
  "name": "carribean",
  "productName": "Carribean",
  "version": "1.0.0",
  "private": true,
  "description": "Your personal film library and watchlists.",
  "author": "Aryan Wadhawan",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "test": "node --test"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "26.18.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "com.carribean.library",
    "directories": { "output": "release" },
    "files": ["desktop/**", "core/**", "dist/**", "package.json"],
    "win": { "icon": "branding/icon.ico", "signExecutable": false },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Carribean-Setup-${version}.${ext}"
    }
  }
}
